# Salin ke Dokku config: dokku config:set fundcore $(cat .env | xargs)
# JANGAN commit file .env berisi kredensial asli.

# --- Umum ---
PORT=3000
ORIGIN=https://donasi.domainanda.com
# Di belakang reverse proxy (Dokku nginx): agar URL & deteksi protokol benar
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=host
ADDRESS_HEADER=X-Forwarded-For
PASSWORD_SALT=ganti-dengan-string-acak-panjang

# --- Winpay Checkout Page (PRD §6.4) ---
WINPAY_MOCK=true            # false di produksi
WINPAY_ENV=sandbox           # sandbox | production
WINPAY_BASE_URL=             # kosong = default per ENV (sandbox-checkout.winpay.id / checkout.winpay.id)
WINPAY_API_KEY=
WINPAY_API_SECRET=
WINPAY_CALLBACK_SECRET=ganti-path-rahasia-callback   # dipakai di /webhooks/winpay/{secret}

# --- WAHA WhatsApp (PRD §6.5) ---
WAHA_MOCK=true               # false bila WAHA live
WA_MIN_INTERVAL_MS=6000      # rate limit per nomor CS (±10 pesan/menit)

# --- Data (mode file bawaan; ganti Postgres bila skala naik) ---
DATA_DIR=./data

# --- Nanti (Postgres/Redis/MinIO/S3 bila sudah ada) ---
# DATABASE_URL=postgres://...
# REDIS_URL=redis://...
# S3_ENDPOINT=https://minio.domainanda.com
# S3_BUCKET_PUBLIC=fundcore-public
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
